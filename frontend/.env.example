# Frontend env. Copy to frontend/.env (or frontend/.env.local) and fill in.
# Vite only exposes vars prefixed with VITE_ to the browser bundle — do NOT
# put server secrets (service-role key, JWT secret, NVIDIA_API_KEY) here.
# They would be baked into the static JS at build time and visible to anyone
# with the URL.

# Supabase project URL — same value as backend's SUPABASE_URL.
VITE_SUPABASE_URL=

# Supabase anon key — same as backend's SUPABASE_ANON_KEY. RLS scopes it
# to the signed-in user, so it's safe to ship in the bundle.
VITE_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend.
# Local dev: http://localhost:8000
# When deployed: whatever URL the backend host assigns (e.g. https://<app>.fly.dev).
VITE_API_BASE_URL=http://localhost:8000
