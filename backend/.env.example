# Backend env. Copy to backend/.env and fill in.
# pydantic-settings reads from `backend/.env` first, then `../env` (root).
# If you're running via docker compose, you can put everything in the root
# `.env` instead and skip this file.

# ─── Supabase ───────────────────────────────────────────────
# Project URL — https://<project-ref>.supabase.co.
# Note: we derive the JWKS URL from this (<url>/auth/v1/.well-known/jwks.json)
# and verify JWTs asymmetrically (RS256) — no shared secret needed.
SUPABASE_URL=
# Service-role key — **server-only**. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name for raw uploaded files. Created by the migration.
SUPABASE_STORAGE_BUCKET=documents

# Direct Postgres connection — used ONLY by Alembic migrations, never by the
# runtime app. From Supabase: Project Settings → Database → Connection string
# → "URI" (NOT the pooler — migrations need persistent transactions, port 5432).
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ─── NVIDIA NIM (OpenAI-compatible) ─────────────────────────
# Free-tier API key from https://build.nvidia.com (~1000 credits).
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# Chat model — see build.nvidia.com for the current catalog.
NVIDIA_CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Embedding model — 1024-dim. Must match `vector(1024)` in the migration.
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the FastAPI app.
CORS_ORIGINS=http://localhost:5173
